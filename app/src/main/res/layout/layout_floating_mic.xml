<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Nút 1 (TRÊN): Chạm để hỏi bằng giọng nói (Hành động chính) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHoi"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#FF7043"
        app:cardCornerRadius="32dp"
        app:cardElevation="10dp">

        <ImageView
            android:id="@+id/imgHoi"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="Hỏi trợ lý bằng giọng nói"
            android:src="@drawable/ic_mic_large"
            app:tint="#FFFFFF" />
    </androidx.cardview.widget.CardView>

    <!-- Khoảng cách an toàn giữa 2 nút (Tránh bấm nhầm) -->
    <View
        android:layout_width="1dp"
        android:layout_height="14dp" />

    <!-- Nút 2 (DƯỚI): Bật quét màn hình 1 lần (Hành động phụ) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTheoDoi"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#757575"
        app:cardCornerRadius="32dp"
        app:cardElevation="10dp">

        <ImageView
            android:id="@+id/imgTheoDoi"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="Quét và đọc màn hình hiện tại"
            android:src="@android:drawable/ic_menu_view"
            app:tint="#FFFFFF" />
    </androidx.cardview.widget.CardView>

</LinearLayout>