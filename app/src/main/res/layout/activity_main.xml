<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    tools:context=".MainActivity">

    <!-- TOP HEADER APP BAR -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_app"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Hình ảnh nhân vật con người tách nền trong suốt đặt kế bên tiêu đề -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="54dp"
            android:contentDescription="Hình ảnh nhân vật Trợ lý Cháu Ơi hỗ trợ bà"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_app_logo_transparent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trợ Lý Số Cháu Ơi"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cháu luôn sẵn sàng hỗ trợ ông bà"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- HERO CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVoiceHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <!-- VÒNG TRÒN NỔI BẬT BAO QUANH NÚT MICRO -->
                    <FrameLayout
                        android:id="@+id/frameMicWrapper"
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:background="@drawable/bg_mic_ripple"
                        android:padding="12dp">

                        <!-- NÚT MICRO BỰ (166dp x 166dp) -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnMicro"
                            android:layout_width="166dp"
                            android:layout_height="166dp"
                            android:layout_gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/accent_mic_idle"
                            app:cardCornerRadius="83dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/imgMicIcon"
                                android:layout_width="84dp"
                                android:layout_height="84dp"
                                android:layout_gravity="center"
                                android:contentDescription="Nút micro nói chuyện với cháu"
                                android:src="@drawable/ic_mic_large"
                                app:tint="@color/white" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <!-- NHÃN HƯỚNG DẪN BẤM -->
                    <TextView
                        android:id="@+id/tvMicActionHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Bấm vào đây để nói"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_mic_idle"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- VIÊN THUỐC TRẠNG THÁI -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_status_pill_ready"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp"
                        android:text="🎙️ Sẵn sàng lắng nghe ông bà"
                        android:textColor="@color/status_ready_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- KHUNG XÁM CÂU NÓI MẪU -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/bg_app"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💡 Ví dụ câu nói mẫu:"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:lineSpacingExtra="4dp"
                                android:text="• &quot;Cháu ơi, đặt lịch khám&quot;\n• &quot;Cháu ơi, cấp lại thẻ bảo hiểm&quot;\n• &quot;Cháu ơi, làm lại căn cước&quot;"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TIÊU ĐỀ SECTION DỊCH VỤ TRỰC TIẾP -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Hoặc bấm chọn trực tiếp dịch vụ:"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- CARD DỊCH VỤ 1: VssID (BẢO HIỂM Y TẾ - LOGO ỨNG DỤNG THẬT VSSID) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVssID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="80dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- LOGO ỨNG DỤNG VSSID THẬT -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Logo chính thức VssID BHXH Việt Nam"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_vssid_real_logo" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cấp lại thẻ Bảo Hiểm Y Tế"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ứng dụng VssID - BHXH Việt Nam"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Mở dịch vụ"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOpenVssID"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:visibility="gone" />
            </androidx.cardview.widget.CardView>

            <!-- CARD DỊCH VỤ 2: VNeID (CĂN CƯỚC - LOGO ỨNG DỤNG THẬT VNEID) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVNeID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="80dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- LOGO ỨNG DỤNG VNEID THẬT -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Logo chính thức VNeID Bộ Công An"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_vneid_real_logo" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Làm lại thẻ Căn Cước"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ứng dụng VNeID - Bộ Công An"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Mở dịch vụ"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOpenVNeID"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:visibility="gone" />
            </androidx.cardview.widget.CardView>

            <!-- CARD DỊCH VỤ 3: YouMed (KHÁM BỆNH - LOGO ỨNG DỤNG THẬT YOUMED) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardYouMed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="80dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- LOGO ỨNG DỤNG YOUMED THẬT -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Logo chính thức YouMed Đặt lịch khám"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_youmed_real_logo" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đặt lịch khám bệnh"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ứng dụng YouMed - Đặt lịch khám"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Mở dịch vụ"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOpenYouMed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:visibility="gone" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🛡️ Ứng dụng Hỗ Trợ Dịch Vụ Số Cho Người Cao Tuổi"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>